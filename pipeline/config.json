{
  "owner": "KAFKA2306",
  "model": "auto",
  "candidate_count": 8,
  "revision_limit": 3,
  "paths": {
    "candidates": "artifacts/candidates",
    "reports": "artifacts/reports",
    "published": "articles"
  },
  "filename_policy": {
    "format": "YYYY-MM-DD-NN-title",
    "sequence_width": 2,
    "max_slug_length": 50,
    "title_max_length": 36,
    "new_articles_only": true,
    "rename_existing_articles": false,
    "zenn_slug_reference": "https://zenn.dev/zenn/articles/what-is-slug"
  },
  "graphiti": {
    "repo": "KAFKA2306/graphiti",
    "weekly_dir": "diary/weekly",
    "max_records": 4,
    "max_chars_per_record": 18000
  },
  "quality_gate": {
    "target_overall": 4.1,
    "minimum_overall": 3.8,
    "minimum_axis": 3.5,
    "target_story_overall": 4.3,
    "minimum_story_overall": 4.0,
    "minimum_story_axis": 3.8,
    "minimum_interest": 4.1,
    "minimum_primary_sources": 3,
    "minimum_own_github_evidence": 2
  },
  "title_policy": {
    "minimum_candidates": 3,
    "candidate_roles": [
      "general_problem",
      "concrete_anomaly",
      "searchable"
    ],
    "prefer_plain_language_entry": true,
    "technical_terms_after_problem": true,
    "require_selected_from_candidates": true,
    "blocking_issue": "narrow_technical_title_entry"
  },
  "reader_value_policy": {
    "required_fields": [
      "reader_before",
      "reader_after",
      "design_philosophy",
      "why_this_article",
      "proof_of_value",
      "desired_reader_action",
      "non_goal"
    ],
    "require_actionable_reader_after": true,
    "forbid_generic_why": true,
    "blocking_issues": [
      "weak_reader_value",
      "weak_differentiation",
      "missing_proof_of_value",
      "forced_commercial_cta",
      "technical_value_as_product"
    ]
  },
  "benchmark_policy": {
    "positive_min_likes": 100,
    "positive_requires_confirmed_like_count": true,
    "below_threshold_role": "non_positive_or_antipattern",
    "like_count_role": "eligibility_filter_not_quality_proof",
    "lapras_role": "quality_floor_not_objective",
    "minimum_positive_exemplars": 1,
    "forbid_style_imitation": true
  },
  "ratchet_kpis": [
    "publication_pass_rate",
    "primary_source_rate",
    "manual_corrections"
  ],
  "image_policy": {
    "objective": "reader_comprehension",
    "fixed_count": null,
    "require_explanatory_value": true
  },
  "lapras_axes": [
    "論理性",
    "実用性",
    "読みやすさ",
    "独自性",
    "明確性"
  ],
  "editorial_axes": [
    "interest",
    "discovery",
    "narrative",
    "context"
  ],
  "story_types": [
    "anomaly",
    "contradiction",
    "failure",
    "unexpected-connection",
    "counterintuitive-result",
    "magnitude"
  ],
  "preferred_topics": [
    "backend",
    "infrastructure",
    "product-engineering",
    "technical-leadership",
    "data-engineering",
    "ai-agents"
  ],
  "allowed_primary_source_hosts": [
    "github.com",
    "docs.github.com",
    "docs.python.org",
    "docs.astral.sh",
    "docs.docker.com",
    "kubernetes.io",
    "developer.mozilla.org",
    "openai.com",
    "platform.openai.com",
    "zenn.dev",
    "info.zenn.dev"
  ],
  "evaluation_kind": "internal_lapras_rubric_proxy",
  "editorial_evaluation_kind": "story_interest_proxy",
  "monthly_publication_limit": 1,
  "model_provider": "github-copilot-cli"
}
